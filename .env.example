# ==========================================
# Portfolio Email Configuration (NodeMailer)
# ==========================================
# To send real emails via Gmail SMTP, generate a 16-character Google App Password:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Ensure 2-Step Verification is enabled on your Google account.
# 3. Create an App Password (Name it "Portfolio").
# 4. Copy the 16-character code and paste below in .env.local:

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_TO=your_email@gmail.com

# (Optional) Custom SMTP Provider (defaults to Gmail):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
